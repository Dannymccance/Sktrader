[Unit]
Description=Sktrader five-scanner paper replay and Discord audit (no broker orders)
After=network-online.target sktrader.service dkcapital-mt5-3.service
Wants=network-online.target

[Service]
Type=simple
User=dkmt5c
Group=dkmt5c
WorkingDirectory=/opt/sktrader
EnvironmentFile=/opt/sktrader/.env
ExecStart=/opt/sktrader/.venv/bin/python -m sktrader.paper_replay --signals /var/lib/dkcapital-mt5-3/.local/share/sktrader/signals.db --market /var/lib/dkcapital-mt5-3/.local/share/sktrader/market_data.db --paper /var/lib/dkcapital-mt5-3/.local/share/sktrader/paper_portfolios.db --common /var/lib/dkcapital-mt5-3/.wine/drive_c/users/dkmt5c/AppData/Roaming/MetaQuotes/Terminal/Common/Files --expected-login 5058169035 --token-file /etc/sktrader/discord-bot-token --channel 1565846495578558526 --interval 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dkcapital-mt5-3/.local/share/sktrader
ReadOnlyPaths=/var/lib/dkcapital-mt5-3/.wine/drive_c/users/dkmt5c/AppData/Roaming/MetaQuotes/Terminal/Common/Files
UMask=0077

[Install]
WantedBy=multi-user.target
