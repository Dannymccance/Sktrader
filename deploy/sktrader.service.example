# Copy to /etc/systemd/system/sktrader.service and replace CHANGE_ME.
# Run as the same Linux user who created the JIFU Chromium session.
[Unit]
Description=Sktrader JIFU watch-only collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/sktrader
EnvironmentFile=/opt/sktrader/.env
ExecStart=/opt/sktrader/.venv/bin/python -m sktrader watch
Restart=always
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
