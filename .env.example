# Never commit real credentials, cookies, browser state or webhook URLs.
SKTRADER_JIFU_URL=https://charts.jifulive.com/jifu/dashboard
# Reuse the existing DK Capital Discord bot for all XAUUSD scanner channels.
# AUROUX remains in this existing channel; setup-channels creates 7 others nearby.
# Bot needs Manage Channels during setup, then View Channel, Send Messages, Embed Links.
SKTRADER_DISCORD_CHANNEL_ID=1565508564775075981
# All scanner channel IDs are stored privately in the browser profile parent folder
# as scanner-channels.json after running setup-channels once.
# An absolute path to a private, owner-only local token file (never the token itself).
SKTRADER_DISCORD_BOT_TOKEN_FILE=/var/lib/dkcapital-mt5-3/.local/share/sktrader/discord-bot-token
SKTRADER_POLL_SECONDS=5
# Only XAUUSD across all eight JIFU scanners, no timeframe/range filter.
# Leave JIFU Alerts scanner selector at Select Scanner (not AUROUX).
# Legacy SKTRADER_TIMEFRAME and SKTRADER_LEVELS in an existing .env are ignored.
SKTRADER_HEADLESS=true
# For dedicated 1920x1080 VNC display :155 use 1760 x 920
SKTRADER_VIEWPORT_WIDTH=1160
SKTRADER_VIEWPORT_HEIGHT=640
SKTRADER_BROWSER_PROFILE=/home/CHANGE_ME/.local/share/sktrader/jifu-profile
SKTRADER_DATABASE=/home/CHANGE_ME/.local/share/sktrader/signals.db
